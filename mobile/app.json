{
  "expo": {
    "name": "Poultri",
    "slug": "poultri",
    "scheme": "poultri",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/poultri-logo.png",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.poultri.mobile",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/poultri-logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-system-ui",
      "expo-router",
      "./plugins/with-local-bridge-http"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f8cad76-4690-4a37-a65d-a4b1563beec9"
      }
    },
    "owner": "kylehatestheworld"
  }
}
